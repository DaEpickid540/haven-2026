[gd_scene format=3]

[ext_resource type="Script" path="res://Scripts/death_screen.gd" id="1_death"]

[node name="DeathScreen" type="CanvasLayer"]
process_mode = 3
layer = 6
script = ExtResource("1_death")

[node name="Overlay" type="Control" parent="."]
unique_name_in_owner = true
visible = false
layout_mode = 3
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2

[node name="Dimmer" type="ColorRect" parent="Overlay"]
layout_mode = 1
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
color = Color(0.18, 0.02, 0.04, 0.8)

[node name="Panel" type="PanelContainer" parent="Overlay"]
layout_mode = 1
anchors_preset = 8
anchor_left = 0.5
anchor_top = 0.5
anchor_right = 0.5
anchor_bottom = 0.5
grow_horizontal = 2
grow_vertical = 2

[node name="VBoxContainer" type="VBoxContainer" parent="Overlay/Panel"]
custom_minimum_size = Vector2(96, 0)
layout_mode = 2
theme_override_constants/separation = 4

[node name="Title" type="Label" parent="Overlay/Panel/VBoxContainer"]
layout_mode = 2
theme_type_variation = &"HeaderLabel"
text = "YOU DIED"
horizontal_alignment = 1

[node name="Coins" type="Label" parent="Overlay/Panel/VBoxContainer"]
unique_name_in_owner = true
layout_mode = 2
text = "Coins kept: 0"
horizontal_alignment = 1

[node name="TitleGap" type="Control" parent="Overlay/Panel/VBoxContainer"]
custom_minimum_size = Vector2(0, 4)
layout_mode = 2
mouse_filter = 2

[node name="Retry" type="Button" parent="Overlay/Panel/VBoxContainer"]
unique_name_in_owner = true
custom_minimum_size = Vector2(96, 0)
layout_mode = 2
size_flags_horizontal = 4
text = "Back to hub"

[node name="MainMenu" type="Button" parent="Overlay/Panel/VBoxContainer"]
custom_minimum_size = Vector2(96, 0)
layout_mode = 2
size_flags_horizontal = 4
text = "Main menu"

[connection signal="pressed" from="Overlay/Panel/VBoxContainer/Retry" to="." method="_on_retry_pressed"]
[connection signal="pressed" from="Overlay/Panel/VBoxContainer/MainMenu" to="." method="_on_main_menu_pressed"]
